@page "/"
@page "/symbols"

@page "/symbols"
@using Microsoft.EntityFrameworkCore
@using StrategyMate.Data
@using StrategyMate.Models
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject ILogger<Symbols> Logger

<PageTitle>Symbols</PageTitle>

<div class="container-fluid py-4" dir="rtl">

    <!-- ================= Header ================= -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1 fw-bold">
                <i class="bi bi-collection text-primary me-2"></i>
                Symbols
            </h3>
        </div>
        @if (symbols is not null)
        {
            <span class="badge bg-primary fs-6">@symbols.Count symbols</span>
        }
    </div>

    <!-- ================= States ================= -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
            <div class="mt-3 text-muted">Loading symbols...</div>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="alert alert-danger">
            <strong>Failed to load symbols:</strong>
            <div class="small mt-1">@errorMessage</div>
        </div>
    }
    else if (symbols is null || symbols.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No symbols found in the database.
        </div>
    }
    else
    {
        <!-- ================= Table ================= -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 symbols-table">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center" style="width: 60px;">#</th>
                                <th>Symbol</th>
                                <th>Company</th>
                                <th>Instrument Code</th>
                                <th>Group</th>
                                <th>Sub-Group</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var rowNumber = 0; }
                            @foreach (var s in symbols)
                            {
                                rowNumber++;
                                <tr @key="s.Id">
                                    <td class="text-center text-muted small">@rowNumber</td>
                                    <td>
                                        <span class="fw-bold text-primary">@s.SymbolName</span>
                                    </td>
                                    <td class="text-muted">@s.CompanyName</td>
                                    <td>
                                        <code class="small">@s.InstrumentCode</code>
                                    </td>
                                    <td>
                                        @if (s.Group is not null)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                @s.Group.GroupName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (s.SubGroup is not null)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                                                @s.SubGroup.SubGroupName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // ================= State =================
    private List<Symbol>? symbols;
    private bool isLoading;
    private string? errorMessage;

    // ================= Lifecycle =================
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // ================= Data loading =================
    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // Create a short-lived DbContext to avoid holding a connection
            // open for the lifetime of the component.
            await using var db = await DbContextFactory.CreateDbContextAsync();

            // Eagerly load the navigation properties so we can render
            // group and sub-group names without extra round-trips.
            symbols = await db.Symbols
                .AsNoTracking()
                .Include(s => s.Group)
                .Include(s => s.SubGroup)
                .OrderBy(s => s.SymbolName)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Logger.LogError(ex, "Failed to load symbols.");
        }
        finally
        {
            isLoading = false;
        }
    }
}